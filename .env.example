# Empty values enable LOCAL DEMO ONLY, shared between tabs in the same browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only. Generate your own VAPID key pair, never commit its private key.
VAPID_PRIVATE_KEY=

# Optional server-only key for the supported Google Drive API.
# Without it, the fixed public TV folder uses a best-effort public HTML adapter.
GOOGLE_DRIVE_API_KEY=
